# Servidor Fastify
PORT=8000
NODE_ENV=development
# CORS_ORIGIN: soporta '*', orígenes separados por coma, sin slash final o comodines (ej: *.workers.dev, *.pages.dev)
CORS_ORIGIN=*
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# PostgreSQL (Neon.tech con connection pooling)
# Reemplazar con tu cadena de conexión de Neon:
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/barflow?sslmode=require
